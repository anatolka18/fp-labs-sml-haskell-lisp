            ]
  
        }
    },
    {  
        "key" : "f9",
        "command" : "workbench.action.terminal.sendSequence",
        "when" : "resourceExtname == .hs",
        "args": {
            "text" : ":load ${fileBasename}\r"
        }
    },
    {  
        "key" : "f9",
        "command" : "workbench.action.terminal.sendSequence",
